<?php
// {{ ansible_managed }}

define( 'DB_NAME', '{{ wp_db_name }}' );
define( 'DB_USER', '{{ wp_db_user }}' );
define( 'DB_PASSWORD', '{{ wp_db_password }}' );
define( 'DB_HOST', '{{ wp_db_host }}' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

// Clés générées une seule fois puis stockées dans secrets/ (idempotent)
{% for key in wp_salt_keys %}
define( '{{ key }}', '{{ lookup("ansible.builtin.password", playbook_dir ~ "/secrets/" ~ key | lower ~ " length=64 chars=ascii_letters,digits") }}' );
{% endfor %}

$table_prefix = 'wp_';

define( 'WP_DEBUG', false );

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

require_once ABSPATH . 'wp-settings.php';